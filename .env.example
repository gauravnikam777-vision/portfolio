# =====================================================
# AI Portfolio — Environment Variables Template
# Copy to .env and fill in your values.
#   cp .env.example .env
# NEVER commit .env to git.
# =====================================================

# ── Flask ─────────────────────────────────────────────
# Use development locally; switch to production in deployment.
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# ── Database (PostgreSQL) ─────────────────────────────
DB_USER=portfolio_user
DB_PASSWORD=portfolio_pass
DB_NAME=ai_portfolio
# Full URL overrides the parts above (used inside Docker / production).
# Leave DATABASE_URL empty for local SQLite development.
DATABASE_URL=

# ── Redis (optional — for rate-limit storage) ─────────
# Use memory:// for local development if Redis is not installed.
REDIS_URL=memory://

# ── Admin API ─────────────────────────────────────────
ADMIN_API_KEY=12345

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins (* for any)
CORS_ORIGINS=*

# ── Email (contact form → sends you an email) ─────────
EMAIL_ENABLED=false
# When true, set these:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=gauravnikam072@gmail.com
# Use a Gmail App Password (not your account password).
# Generate at: https://myaccount.google.com → Security → App passwords
MAIL_PASSWORD=
# MAIL_PASSWORD should NOT be committed. Set this to your email account's
# app-specific password when `EMAIL_ENABLED=true`. Example: MAIL_PASSWORD=your_app_password
OWNER_EMAIL=gauravnikam072@gmail.com



# ── Gunicorn tuning ───────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
